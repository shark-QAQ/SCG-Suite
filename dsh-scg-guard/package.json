{
  "name": "dsh-scg-guard",
  "version": "1.1.0",
  "description": "Taint-aware session guard for DeepSeek Harness: Cedar policy, sandbox lockdown, egress isolation, hash-chained audit",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "agent-security",
    "guardrail",
    "cedar",
    "audit"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "policies",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc && node scripts/bundle.mjs",
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/index.test.mjs",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "^4.14.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@scg/core": "workspace:*",
    "@scg/egress": "workspace:*",
    "@scg/events": "workspace:*",
    "@scg/netns": "workspace:*",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0"
  }
}
